# Mux API Credentials
# Get these from: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your-mux-token-id-here
MUX_TOKEN_SECRET=your-mux-token-secret-here

# Mux Signing Keys for Secure Playback
# Get these from: https://dashboard.mux.com/settings/signing-keys
# Generate a new signing key in Mux Dashboard to get both Key ID and Private Key
MUX_SIGNING_KEY_ID=your-mux-signing-key-id-here
MUX_SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-mux-signing-private-key-here
-----END RSA PRIVATE KEY-----"

# Database Configuration
# Path to SQLite database file (will be created automatically)
DATABASE_PATH=./videos.db

# JWT Keys for Signed Playback
# Generate RSA key pair with:
# openssl genrsa -out private_key.pem 2048
# openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then paste the full PEM content (including BEGIN/END lines) as a single line with \n for newlines
# Or use the actual multiline format in your .env file
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# Server Configuration
# Port for the backend server to listen on
SERVER_PORT=8080

# Frontend URL for CORS configuration
# Change this if your frontend runs on a different port
FRONTEND_URL=http://localhost:3000

# Optional: Webhook Secret (if using Mux webhooks)
# Get this from: https://dashboard.mux.com/settings/webhooks
# MUX_WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Environment
# Set to "production" for production deployments
# ENVIRONMENT=development
